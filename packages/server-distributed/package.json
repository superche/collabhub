{
  "name": "@collabhub/server-distributed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --external:pg-native --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/collabhub-node.mjs",
    "test": "vitest run src"
  },
  "dependencies": {
    "@collabhub/domain-json": "workspace:*",
    "@collabhub/protocol": "workspace:*",
    "@collabhub/strategy-sdk": "workspace:*",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
