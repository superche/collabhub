{
  "name": "@collabhub/server-distributed",
  "version": "0.1.0",
  "description": "Horizontally scalable CollabHub Gateway and Room Worker runtime",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/superche/collabhub.git", "directory": "packages/server-distributed" },
  "homepage": "https://github.com/superche/collabhub#readme",
  "bugs": "https://github.com/superche/collabhub/issues",
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "node ../../scripts/clean-package-output.mjs && tsc -b --force",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --external:pg-native --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/bin/collabhub-node.mjs",
    "test": "vitest --root ../.. run packages/server-distributed/src",
    "prepack": "pnpm build && pnpm build:bundle"
  },
  "dependencies": {
    "@collabhub/domain-json": "workspace:*",
    "@collabhub/protocol": "workspace:*",
    "@collabhub/server-core": "workspace:*",
    "@collabhub/strategy-sdk": "workspace:*",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
