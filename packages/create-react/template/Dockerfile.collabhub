FROM node:24-alpine

RUN npm install --global @collabhub/server-ws@0.1.2
RUN addgroup -S -g 10001 collabhub && adduser -S -u 10001 -G collabhub collabhub \
  && mkdir -p /data && chown -R collabhub:collabhub /data

USER 10001:10001
ENV PORT=4100 COLLABHUB_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 4100

CMD ["collabhub-server"]
