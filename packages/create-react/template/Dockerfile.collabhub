FROM node:24-alpine

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json server.ts collabhub.model.ts ./
COPY src ./src

RUN addgroup -S -g 10001 collabhub && adduser -S -u 10001 -G collabhub collabhub \
  && mkdir -p /data && chown -R collabhub:collabhub /app /data
USER 10001:10001

ENV NODE_ENV=production PORT=4100 COLLABHUB_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 4100
CMD ["npm", "run", "dev:server"]
