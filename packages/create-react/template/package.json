{
  "name": "collabhub-react-app",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,alice,bob -c blue,green,magenta \"npm:dev:server\" \"npm:dev:alice\" \"npm:dev:bob\"",
    "dev:server": "tsx server.ts",
    "dev:alice": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:bob": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@collabhub/client-core": "^0.1.2",
    "@collabhub/server-ws": "^0.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
