{
  "name": "@collabhub/react-flow-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5193",
    "dev:web:a": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "dev:web:b": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist-server/collabhub-react-flow-demo.mjs",
    "build:domain-pack": "esbuild server/domain-pack-module.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/react-flow-domain-pack.mjs"
  },
  "dependencies": {
    "@collabhub/client-core": "workspace:*",
    "@collabhub/domain-json": "workspace:*",
    "@collabhub/protocol": "workspace:*",
    "@collabhub/server-core": "workspace:*",
    "@collabhub/strategy-sdk": "workspace:*",
    "@xyflow/react": "^12.11.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "vite": "^8.2.2"
  }
}
