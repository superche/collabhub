COLLABHUB_IMAGE=ghcr.io/superche/collabhub:0.2.0
NODE_NAME=collabhub-node-1
PRIVATE_IP=10.0.1.10

# JWT/JWKS used by your existing app login service.
JWT_JWKS_URL=https://app.example.com/.well-known/jwks.json
JWT_ISSUER=https://app.example.com/
JWT_AUDIENCE=collabhub
ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HEADERS=true

PG_POOL_MAX=10
OWNER_LEASE_SECONDS=10
MAX_WARM_ROOMS=1000
IDLE_ROOM_MS=60000
MAX_ROOM_MAILBOX=256
MAX_PAYLOAD_BYTES=131072
SNAPSHOT_INTERVAL=100
MAX_RECOVERY_GAP=100
WAL_RETENTION_VERSIONS=1000
RECEIPT_TTL_MS=604800000
DELIVERED_OUTBOX_TTL_MS=86400000
SNAPSHOTS_PER_DOCUMENT=3
COMPACTION_INTERVAL_MS=600000
RSS_LIMIT_BYTES=3221225472
NODE_OPTIONS=--max-old-space-size=896
