region          = "cn-hangzhou"
name            = "collabhub"
allowed_origin  = "https://app.example.com"
public_hostname = "collab.example.com"
certificate_id  = "REPLACE_WITH_ALIBABA_CLOUD_CERTIFICATE_ID"
jwt_jwks_url    = "https://YOUR_IDP/.well-known/jwks.json"
jwt_issuer      = "https://YOUR_IDP/"
jwt_audience    = "collabhub"

# Each VM runs one Gateway and one Worker. ecs.c7.large is a 2C4G baseline.
instance_type  = "ecs.c7.large"
instance_count = 2

# The published image can load either JSON or the self-contained ESM module below.
container_image = "ghcr.io/superche/collabhub:0.1.3"

# For trusted executable business rules, uncomment and review the source first:
# domain_pack_module_source = file("../../domain-pack/domain-pack.example.mjs")
