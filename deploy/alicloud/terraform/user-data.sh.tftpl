#!/bin/bash
set -euo pipefail

dnf install -y docker jq curl
systemctl enable --now docker
install -d -m 0700 /etc/collabhub /etc/collabhub/secrets /opt/collabhub/config

/bin/bash -c "$(curl -fsSL https://aliyuncli.alicdn.com/install.sh)" -- -V 3.3.18
aliyun configure set --profile collabhub --mode EcsRamRole --ram-role-name '${ram_role_name}' --region '${region}'

get_secret() {
  local secret_name="$1"
  local attempt result
  for attempt in $(seq 1 60); do
    if result=$(aliyun kms GetSecretValue --profile collabhub --region '${region}' --SecretName "$secret_name" 2>/dev/null); then
      printf '%s' "$result" | jq -er .SecretData
      return
    fi
    sleep 5
  done
  echo "Unable to retrieve KMS secret $secret_name" >&2
  return 1
}

INSTANCE_ID=$(hostname)
PRIVATE_IP=$(hostname -I | awk '{print $1}')
DB_PASSWORD=$(get_secret '${database_secret_name}')
REDIS_PASSWORD=$(get_secret '${redis_secret_name}')
INTERNAL_TOKEN=$(get_secret '${internal_secret_name}')
%{ if jwt_secret_name != "" ~}
JWT_SHARED_SECRET=$(get_secret '${jwt_secret_name}')
%{ endif ~}
DB_PASSWORD_URI=$(jq -nr --arg value "$DB_PASSWORD" '$value|@uri')
REDIS_PASSWORD_URI=$(jq -nr --arg value "$REDIS_PASSWORD" '$value|@uri')
printf '%s' "postgresql://collabhub:$DB_PASSWORD_URI@${database_host}:5432/collabhub?sslmode=require" > /etc/collabhub/secrets/database-url
printf '%s' "rediss://default:$REDIS_PASSWORD_URI@${redis_host}:6379" > /etc/collabhub/secrets/redis-url
printf '%s' "$INTERNAL_TOKEN" > /etc/collabhub/secrets/internal-token
%{ if jwt_secret_name != "" ~}
printf '%s' "$JWT_SHARED_SECRET" > /etc/collabhub/secrets/jwt-shared-secret
%{ endif ~}
chmod 0400 /etc/collabhub/secrets/*
unset DB_PASSWORD REDIS_PASSWORD INTERNAL_TOKEN DB_PASSWORD_URI REDIS_PASSWORD_URI
%{ if jwt_secret_name != "" ~}
unset JWT_SHARED_SECRET
%{ endif ~}
printf '%s' '${domain_pack_source_base64}' | base64 -d > /opt/collabhub/config/${domain_pack_file_name}
chmod 0400 /opt/collabhub/config/${domain_pack_file_name}

cat > /etc/collabhub/common.env <<EOF
NODE_ENV=production
DATABASE_URL_FILE=/run/secrets/database-url
REDIS_URL_FILE=/run/secrets/redis-url
INTERNAL_TOKEN_FILE=/run/secrets/internal-token
${domain_pack_environment}=/config/${domain_pack_file_name}
PG_POOL_MAX=10
OWNER_LEASE_SECONDS=10
MAX_WARM_ROOMS=1000
IDLE_ROOM_MS=60000
ROOM_CACHE_SCAN_INTERVAL_MS=3000
WAL_RETENTION_VERSIONS=1000
RECEIPT_TTL_MS=604800000
DELIVERED_OUTBOX_TTL_MS=86400000
SNAPSHOTS_PER_DOCUMENT=3
COMPACTION_INTERVAL_MS=600000
MAX_PAYLOAD_BYTES=131072
RSS_LIMIT_BYTES=3221225472
NODE_OPTIONS=--max-old-space-size=896
EOF

cat > /etc/collabhub/gateway.env <<EOF
COLLABHUB_ROLE=gateway
INSTANCE_ID=$INSTANCE_ID-gateway
PORT=7000
${jwt_auth_environment}
JWT_ISSUER=${jwt_issuer}
JWT_AUDIENCE=${jwt_audience}
ALLOWED_ORIGINS=${allowed_origin}
TRUST_PROXY_HEADERS=true
MAX_GATEWAY_CONNECTIONS=10000
MAX_CONNECTIONS_PER_IP=50
OPERATION_RATE_PER_SECOND=30
OPERATION_BURST=60
EOF

cat > /etc/collabhub/worker.env <<EOF
COLLABHUB_ROLE=worker
INSTANCE_ID=$INSTANCE_ID-worker
PORT=7100
INTERNAL_URL=http://$PRIVATE_IP:7100
MAX_ROOM_MAILBOX=256
SNAPSHOT_INTERVAL=100
MAX_RECOVERY_GAP=100
EOF

chmod 0600 /etc/collabhub/*.env
docker pull '${container_image}'

cat > /etc/systemd/system/collabhub-gateway.service <<'EOF'
[Unit]
Description=CollabHub Gateway
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f collabhub-gateway
ExecStart=/usr/bin/docker run --name collabhub-gateway --network host --env-file /etc/collabhub/common.env --env-file /etc/collabhub/gateway.env --mount type=bind,src=/opt/collabhub/config,dst=/config,readonly --mount type=bind,src=/etc/collabhub/secrets,dst=/run/secrets,readonly ${container_image}
ExecStop=/usr/bin/docker stop -t 30 collabhub-gateway

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/collabhub-worker.service <<'EOF'
[Unit]
Description=CollabHub Room Worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f collabhub-worker
ExecStart=/usr/bin/docker run --name collabhub-worker --network host --env-file /etc/collabhub/common.env --env-file /etc/collabhub/worker.env --mount type=bind,src=/opt/collabhub/config,dst=/config,readonly --mount type=bind,src=/etc/collabhub/secrets,dst=/run/secrets,readonly ${container_image}
ExecStop=/usr/bin/docker stop -t 30 collabhub-worker

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now collabhub-worker collabhub-gateway
