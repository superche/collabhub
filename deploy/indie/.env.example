COLLABHUB_HOST=collab.example.com
# Keep ./Caddyfile for a domain. For a bare public IPv4 address, set
# COLLABHUB_CADDYFILE=./Caddyfile.ip and run ./issue-ip-certificate.sh first.
COLLABHUB_CADDYFILE=./Caddyfile
COLLABHUB_LOOPBACK_PORT=17000
ALLOWED_ORIGINS=https://app.example.com
# Pin a release or immutable certification digest. The value below is the
# current production-hardening certification image.
COLLABHUB_IMAGE=ghcr.io/superche/collabhub:sha-0a102f042808a0fda7b33476fc7b981f47868d56
JWT_ISSUER=https://app.example.com
JWT_AUDIENCE=collabhub
