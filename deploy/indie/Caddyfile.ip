https://{$COLLABHUB_HOST} {
	encode zstd gzip
	tls /etc/letsencrypt/live/collabhub-ip/fullchain.pem /etc/letsencrypt/live/collabhub-ip/privkey.pem

	handle / {
		header Content-Type application/json
		respond `{"service":"CollabHub","status":"online","demo":"https://collabhub-demo.onrender.com/demo.html","health":"/readyz","websocket":"/collab"}` 200
	}

	handle {
		reverse_proxy gateway:7000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}
