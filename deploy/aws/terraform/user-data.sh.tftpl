#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git openssl
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
cat >/etc/apt/sources.list.d/docker.sources <<'DOCKER_REPOSITORY'
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: noble
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
DOCKER_REPOSITORY
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

if ! swapon --show --noheadings | grep -q .; then
  fallocate -l 2G /swapfile
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi

install -d -m 0750 /opt/collabhub
git clone --depth 1 --branch '${release_ref}' '${repository_url}' /opt/collabhub/source
cd /opt/collabhub/source/deploy/indie

cat >.env <<'COLLABHUB_ENV'
COLLABHUB_HOST=${hostname}
COLLABHUB_CADDYFILE=./Caddyfile
COLLABHUB_LOOPBACK_PORT=17000
ALLOWED_ORIGINS=${allowed_origin}
COLLABHUB_IMAGE=${container_image}
JWT_ISSUER=${jwt_issuer}
JWT_AUDIENCE=${jwt_audience}
COLLABHUB_ENV

printf '%s' '${domain_pack_base64}' | base64 --decode >domain-pack.json
chmod 0600 .env domain-pack.json
./install.sh

cat >/etc/cron.d/collabhub-backup <<'BACKUP_CRON'
17 3 * * * root cd /opt/collabhub/source/deploy/indie && ./backup.sh >>/var/log/collabhub-backup.log 2>&1
BACKUP_CRON
chmod 0644 /etc/cron.d/collabhub-backup
