region            = "us-east-1"
availability_zone = "us-east-1a"
name              = "collabhub"

# The browser Origin that owns the React app. This is not the CollabHub hostname.
allowed_origin = "https://app.example.com"
jwt_issuer     = "my-app"
jwt_audience   = "collabhub"

# Default: Lightsail 2 vCPU / 2 GB / 60 GB SSD, advertised at $12/month in
# us-east-1 before tax or transfer overage. Use medium_3_0 for 4 GB at $24/month.
bundle_id = "small_3_0"

# Optional: direct SSH in addition to Lightsail browser SSH.
# admin_cidr    = "203.0.113.8/32"
# key_pair_name = "my-lightsail-key"

# Null uses <static-ip>.sslip.io and automatic HTTPS. Keep this default unless
# a custom hostname already points at a pre-reserved/imported static IP; the
# post-deploy custom-domain migration is documented in deploy/aws/README.md.
# public_hostname = "collab.example.com"

container_image = "ghcr.io/superche/collabhub:1.0.0"
release_ref      = "v1.0.0"

# Optional declarative business rules:
# domain_pack_config_json = file("../../domain-pack/domain-pack.example.json")
